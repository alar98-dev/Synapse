{
  "request": {
    "method": "GET",
    "path": "/api/v1/sandbox/jobs/<id>/",
    "headers": { "Authorization": "Bearer <token>" }
  },
  "response": {
    "status_code": "<int: 200|403>",
    "body": {
      "id": "<int>",
      "user": "<int>",
      "code": "<string>",
      "language": "<string>",
      "status": "<string>",
      "stdout": "<string|null>",
      "stderr": "<string|null>",
      "exit_code": "<int>",
      "container_id": "<string|null>",
      "created_at": "<iso8601>",
      "finished_at": "<iso8601|null>"
    }
  }
}
