components:
  schemas:
    AssessmentSession:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        user:
          type: integer
          readOnly: true
        lesson:
          type: integer
        status:
          allOf:
          - $ref: '#/components/schemas/AssessmentSessionStatusEnum'
          readOnly: true
        started_at:
          type: string
          format: date-time
          readOnly: true
        turns:
          type: array
          items:
            $ref: '#/components/schemas/EvaluationTurn'
          readOnly: true
        report:
          allOf:
          - $ref: '#/components/schemas/CognitiveReport'
          readOnly: true
      required:
      - id
      - lesson
      - report
      - started_at
      - status
      - turns
      - user
    AssessmentSessionStatusEnum:
      enum:
      - active
      - converged
      - failed
      type: string
      description: |-
        * `active` - Active
        * `converged` - Converged
        * `failed` - Failed
    CognitiveReport:
      type: object
      properties:
        score:
          type: number
          format: double
        summary:
          type: string
        dimensions: {}
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - dimensions
      - score
      - summary
    Cohort:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        course:
          type: integer
        title:
          type: string
          maxLength: 255
        start_date:
          type: string
          format: date
        end_date:
          type: string
          format: date
        capacity:
          type: integer
          maximum: 2147483647
          minimum: 0
        timezone:
          type: string
          maxLength: 64
        enrollment_open:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - course
      - created_at
      - end_date
      - id
      - start_date
      - title
      - updated_at
    Course:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 255
        slug:
          type: string
          maxLength: 255
          pattern: ^[-a-zA-Z0-9_]+$
        description:
          type: string
        level:
          $ref: '#/components/schemas/LevelEnum'
        language:
          type: string
          maxLength: 32
        is_published:
          type: boolean
        duration_hours:
          type: string
          format: decimal
          pattern: ^-?\d{0,3}(?:\.\d{0,2})?$
          nullable: true
        price:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        cohorts:
          type: array
          items:
            $ref: '#/components/schemas/Cohort'
          readOnly: true
      required:
      - cohorts
      - created_at
      - id
      - title
      - updated_at
    EvaluationTurn:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        speaker:
          type: string
          maxLength: 20
        content:
          type: string
        timestamp:
          type: string
          format: date-time
          readOnly: true
        inference:
          nullable: true
      required:
      - content
      - id
      - speaker
      - timestamp
    ExecutionJob:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        user:
          type: integer
          nullable: true
        code:
          type: string
        language:
          type: string
          maxLength: 32
        status:
          allOf:
          - $ref: '#/components/schemas/StatusCd9Enum'
          readOnly: true
        stdout:
          type: string
          readOnly: true
          nullable: true
        stderr:
          type: string
          readOnly: true
          nullable: true
        exit_code:
          type: integer
          readOnly: true
          nullable: true
        duration:
          type: number
          format: double
          readOnly: true
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        started_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        finished_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
      required:
      - code
      - created_at
      - duration
      - exit_code
      - finished_at
      - id
      - started_at
      - status
      - stderr
      - stdout
    LevelEnum:
